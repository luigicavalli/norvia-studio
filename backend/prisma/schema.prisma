datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}


// ------
// ENUMS
// ------

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Currency {
  USD
  EUR
  GBP
}


// -------
// MODELS
// -------

model Company {
  id         String   @id @default(uuid())
  name       String
  tax_code   String   @unique
  email      String
  phone      String
  address    String
  city       String
  zip_code   String
  country    String
  website    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  clients Client[]

  @@map("companies")
}

model Client {
  id         String       @id @default(uuid())
  first_name String
  last_name  String
  email      String       @unique
  phone      String
  company_id String
  company    Company      @relation(fields: [company_id], references: [id])
  vat_number String?
  status     ClientStatus @default(PROSPECT)
  notes      String?
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  projects Project[]

  @@map("clients")
}

model Project {
  id              String          @id @default(uuid())
  name            String
  description     String?
  client_id       String
  client          Client          @relation(fields: [client_id], references: [id])
  status          ProjectStatus   @default(DRAFT)
  priority        ProjectPriority @default(MEDIUM)
  budget_amount   Decimal?
  budget_currency Currency?
  start_date      DateTime?
  due_date        DateTime?
  completed_at    DateTime?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  @@map("projects")
}
